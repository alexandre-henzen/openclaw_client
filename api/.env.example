NODE_ENV=development
JWT_SECRET=your-secret-here
DB_PATH=./data/openclaw.sqlite
# Normally driven by ~/.openclaw_client/.env (API_PORT / CLIENT_PORT). Listed
# here for reference.
PORT=18802

# --- Bootstrap admin (created only when no active user exists) ---
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=123456
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_LAST_NAME=User
# SEED_ADMIN_PHONE=

# --- Data retention (agui_events + visual_artifacts + orphan files) ---
DATA_RETENTION_DAYS=7
# Set to 0 to disable GC. Default purge interval: 24h.
# DATA_RETENTION_INTERVAL_HOURS=24

# --- CORS ---
# OpenClaw Client is a single-user local app that you typically reach from
# multiple devices on your LAN / Tailscale, so the default policy is
# "allow every origin". Uncomment the two lines below to lock it down to
# a strict allowlist.
# ALLOWED_DOMAIN=http://localhost:18800,http://my-host.tail-net.ts.net:18800
# OPENCLAW_STRICT_CORS=1

# --- API public URL ---
# Optional fallback used when the API can't read `Host` from the
# request (server-to-server callers). Normal browser traffic always
# uses the request host so workspace URLs match wherever the client is.
# API_PUBLIC_URL=http://localhost:18802

# --- Reverse proxy on a single domain ---
# Lives in ~/.openclaw_client/.env (the user-facing config), not here, but
# noted for reference: when set, the static UI server injects
# `apiBaseUrl: '/api'` into the page so the browser issues same-origin
# requests. nginx / Caddy / your TLS proxy is then expected to route
# /api/* and /ws/* to this API process.
# USE_RELATIVE_API_URL=0

# --- CopilotKit + AG-UI + clawg-ui (SPEC-001) ---
# APP_AUTH_SECRET=min-32-chars-random-secret-for-hmac-and-encryption
# SESSION_KEY_SALT=random-salt-for-openclaw-session-key-scope
# Copiadas automaticamente de `.env` (raiz) via: npm run sync:env
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_CLAWG_UI_PATH=/v1/clawg-ui
# OPENCLAW_GATEWAY_TOKEN=   # Gateway WS only — never clawg-ui bearer
# OPENCLAW_PAIRING_APPROVE_URL=http://127.0.0.1:18790
# Stack Docker: npm run openclaw:up  (docker-compose.yml na raiz)
