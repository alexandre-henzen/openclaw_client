{
  "name": "openclaw-api",
  "version": "1.0.0",
  "description": "OpenClaw Client API — Express + TypeORM + SQLite backend",
  "main": "app.ts",
  "scripts": {
    "lint": "eslint src",
    "test": "npm run test:agui:fixtures && npm run test:security && npm run test:auth && npm run test:agui:proxy && npm run test:artifacts && npm run test:artifacts:observer && npm run test:config && npm run test:phase-c",
    "dev": "nodemon --ext yaml,js,json,ts,*.d.ts --exec \"ts-node ./src/app.ts\"",
    "build": "tsc --build",
    "start": "node build/src/app.js",
    "test:agui:fixtures": "node --test tests/agui/event-parser.test.mjs",
    "test:agui:proxy": "node --test tests/agui/clawg-ui-proxy.integration.test.mjs",
    "test:security": "node --test tests/security/crypto.test.mjs tests/security/app-session.test.mjs tests/security/session-scope.test.mjs",
    "test:auth": "node --test tests/auth/auth.integration.test.mjs",
    "test:artifacts": "node --test tests/artifacts/mime-policy.test.mjs tests/artifacts/sanitize-media-text.test.mjs",
    "test:artifacts:observer": "node --test tests/artifacts/run-code-observer.integration.test.mjs",
    "test:config": "node --test tests/config/seed-admin.test.mjs tests/config/retention.test.mjs",
    "test:phase-c": "node --test tests/phase-c/phase-c.integration.test.mjs",
    "migration:run": "npm run build && node ./build/src/run-migrations.js",
    "test:harness:smoke": "node --test tests/harness/smoke-copilot.mjs",
    "test:harness:artifacts": "node --test tests/harness/smoke-artifacts.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ag-ui/client": "^0.0.55",
    "@copilotkit/runtime": "^1.59.5",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^1.20.1",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "error-stack-parser": "^2.1.4",
    "eventsource-parser": "^3.1.0",
    "express": "^4.18.2",
    "express-validator": "^6.14.3",
    "helmet": "^6.0.1",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "marked": "^15.0.12",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.0",
    "typeorm": "^0.3.28",
    "ulid": "^2.4.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.16",
    "@types/http-errors": "^2.0.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.11.18",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/ws": "^8.18.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.4",
    "nodemon": "^3.1.11",
    "openapi-types": "^12.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  }
}
