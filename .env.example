# Copie para .env na raiz do repositório e preencha os segredos.
# O gateway OpenClaw lê este arquivo via docker compose.

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_MODE=local
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_CONFIG_DIR=C:/Users/<you>/.openclaw
OPENCLAW_WORKSPACE_DIR=C:/Users/<you>/.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=C:/Users/<you>/.openclaw-auth-profile-secrets

# Gere um token forte antes de expor em rede externa.
OPENCLAW_GATEWAY_TOKEN=

# OpenRouter (recomendado para Kimi K2.6)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENCLAW_DEFAULT_MODEL=openrouter/moonshotai/kimi-k2.6

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# run_code native gateway tool
SANDBOX_BACKEND=e2b
PISTON_URL=http://piston:2000/api/v2
PISTON_RUN_TIMEOUT_MS=30000
E2B_API_KEY=
E2B_TEMPLATE=
E2B_SANDBOX_TIMEOUT_MS=300000
SANDBOX_NETWORK=none
SANDBOX_ALLOW_NETWORK=0

# Korp BI — serviço korp-mcp-gateway (OAuth + proxy MCP)
KORP_OAUTH_CLIENT_ID=
KORP_OAUTH_CLIENT_SECRET=
KORP_OAUTH_TOKEN_URL=https://gateway.korp.com.br/oauth/connect/token
KORP_OAUTH_SCOPE=mcp:datawarehouse-elt mcp:datawarehouse-projetos
KORP_MCP_URL=https://api.korp.com.br/bi/v1/mcp
KORP_TOKEN_REFRESH_SKEW_MS=120000
KORP_TOKEN_REFRESH_INTERVAL_MS=60000

# Chat UI: aprovação automática de pairing clawg-ui
OPENCLAW_PAIRING_APPROVE_URL=http://127.0.0.1:18790
